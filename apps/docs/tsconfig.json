{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "incremental": true,
    "types": ["node"],
    "paths": {
      "@/*": ["../../packages/composerkit/src/*"],
      "@docs/*": ["./*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mjs",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../../packages/composerkit/src"
  ],
  "exclude": ["node_modules", "out"]
}
