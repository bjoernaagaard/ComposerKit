{
  "name": "composerkit",
  "version": "0.1.1",
  "description": "Composer and conversation components for React, built on Base UI and Tailwind CSS v4",
  "keywords": [
    "base-ui",
    "chat",
    "composer",
    "conversation",
    "react",
    "shadcn",
    "tailwindcss"
  ],
  "homepage": "https://bjoernaagaard.github.io/ComposerKit/",
  "bugs": {
    "url": "https://github.com/bjoernaagaard/ComposerKit/issues"
  },
  "license": "MIT",
  "author": "Bjørn Aagaard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bjoernaagaard/ComposerKit.git",
    "directory": "packages/composerkit"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/finish-dist.ts",
    "prepack": "npm run build",
    "registry:build": "node ../../scripts/tokens.ts && shadcn build --output ../../apps/docs/public/r",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.63.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
